{:paths ["src" "test" "lib"]
 ;; kototama.tender (ADR-2607022400 names the "tender" ROLE; ADR-2607022900
 ;; separately decided THIS implementation of that role is JVM/Clojure via
 ;; Chicory, not Rust/wasmtime -- other tenders in other host languages
 ;; exist, e.g. aiueos's own JVM-FFM ADR-0014 hvt-tender) is the only
 ;; namespace here needing real deps -- kototama.contract and lib/* stay
 ;; zero-dep/portable.
 :deps {com.dylibso.chicory/wasm     {:mvn/version "1.4.0"}  ; same pin as kotoba-lang/kotoba
        com.dylibso.chicory/runtime {:mvn/version "1.4.0"}
        ;; kotoba-lang/ed25519 was renamed to kotoba-lang/org-ietf-ed25519, and
        ;; the redirect is why the old coordinate kept resolving. tools.deps
        ;; dedupes by the coordinate SYMBOL, so this file was putting ed25519
        ;; on the classpath TWICE: once here as `ed25519` at fdcefb9, and once
        ;; as `org-ietf-ed25519` at c1ba832, which kotoba-lang/security pulls
        ;; in. Measured with `clojure -Stree`.
        ;;
        ;; The sha moves fdcefb9 -> c1ba832 rather than staying put, because
        ;; c1ba832 is what the canonical coordinate ALREADY resolved to here.
        ;; Renaming while keeping fdcefb9 would have made the top-level entry
        ;; win and quietly walked ed25519 backwards to 2026-06-30, undoing
        ;; "make JCA Ed25519 calls Graal-static" (#4). fdcefb9 is an ancestor
        ;; of c1ba832, verified with `git merge-base --is-ancestor` on a full
        ;; clone, so this is a fast-forward and nothing else in the closure
        ;; moves.
        io.github.kotoba-lang/org-ietf-ed25519
        {:git/sha "c1ba8322a33b668da1311ca69a8cdde3c7981b52"}
        ;; llm-infer-host-fn's Anthropic Messages API request/response
        ;; bodies -- same lib+version kototama-clj's :build-taxonomy/
        ;; :enrich aliases already pin elsewhere in this org.
        org.clojure/data.json {:mvn/version "2.5.0"}
        io.github.kotoba-lang/security {:git/url "https://github.com/kotoba-lang/security.git"
                                        :git/sha "f409dbade106df076cefe640781b12db558f4135"}
        io.github.kotoba-lang/kotoba-core-contracts
        {:git/url "https://github.com/kotoba-lang/kotoba-core-contracts.git"
         :git/sha "2e615d17406ef4b6311401167294becceb5af2a1"}
        io.github.kotoba-lang/abi {:git/url "https://github.com/kotoba-lang/abi.git"
                                   :git/sha "32ee84b2efc92478c846629c8d8319280eed506c"}
        ;; Component admission verifies identity CIDs structurally before
        ;; linking; a leading `b` is not evidence of content addressing.
        io.github.kotoba-lang/io-multiformats
        {:git/url "https://github.com/kotoba-lang/io-multiformats.git"
         :git/sha "310724803db65840f00d2d98d7887f2b6a512bd3"}
        ;; kototama.aiueos-adapter calls aiueos.cli/command-result directly
        ;; (in-process, not the bb-decide subprocess -- see the adapter's
        ;; namespace docstring for why) to translate a REAL aiueos policy
        ;; decision into a kototama.contract/host-caps value. aiueos-cljc-
        ;; contract (a short-lived split of aiueos.cli/etc. into its own
        ;; repo) has been merged back into kotoba-lang/aiueos.
        io.github.kotoba-lang/aiueos
        {:git/url "https://github.com/kotoba-lang/aiueos.git"
         :git/sha "c1d0a9bb6f2e4ecb6d9a1616f5a39bed6511d481"}}
 :aliases
 {:cli  {:main-opts ["-m" "kototama.cli"]}
  :authority-daemon {:main-opts ["-m" "kototama.component-authority-daemon"]}
  :tcb-check {:main-opts ["-m" "kototama.tcb"]}
  :release-evidence {:main-opts ["-m" "kototama.release-evidence"]}
  ;; ADR-2607266000 Phase B: the PostgreSQL pool is a Chicory-tender plugin,
  ;; not part of the runtime core. It lives in kotoba-lang/provider-postgres
  ;; and its interop harness went with it. A deployment that wants it adds
  ;; that dependency itself; the tender does not ship a database pool.
  :postgresql-interop
  {:extra-deps {io.github.kotoba-lang/kotoba {:local/root "../kotoba"}
                io.github.kotoba-lang/amu {:local/root "../amu"}
                io.github.kotoba-lang/kotoba-core-contracts
                {:local/root "../kotoba-core-contracts"}
                io.github.kotoba-lang/kotoba-lang {:local/root "../kotoba-lang"}}
   :main-opts ["-m" "kototama.postgresql-interop"]}
  :doctor {:main-opts ["-m" "kototama.cli" "doctor"]}
  ;; The hermetic subset: the namespaces that need nothing but this repo.
  ;;
  ;; `:test` resolves `:local/root "../kotoba"` and friends, which is right
  ;; for a workstation inside the west layout and impossible on a fleet node,
  ;; where only THIS repo's tree is shipped. So the parts that can be checked
  ;; in isolation are named here and gated
  ;; (`scripts/fleet-ci/gates/kototama-hermetic-test.cljs` in the
  ;; superproject), and the parts that cannot are honestly not gated rather
  ;; than pretended at.
  ;;
  ;; Namespaces are listed explicitly rather than discovered: the runner's
  ;; default scan loads every test namespace, including the ones that require
  ;; siblings, and a gate that fails on a missing dependency says nothing
  ;; about the code under test.
  :test-hermetic
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"
               "-n" "kototama.linear-journal-test"
               "-n" "kototama.execution-test"]}

  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/kotoba
                      {:local/root "../kotoba"}
                      ;; The repo was renamed `compiler` -> `amu` (2026-08-10).
                      ;; The coordinate now says `amu` too. It used to say
                      ;; `compiler` on purpose, because sibling `kotoba`
                      ;; declared that coordinate transitively and an override
                      ;; only wins when the key matches -- but `kotoba` main
                      ;; now declares `io.github.kotoba-lang/amu`, so holding
                      ;; the legacy key here stopped overriding anything and
                      ;; started putting two copies of the same repository on
                      ;; one classpath. `../amu` is unchanged; `../compiler`
                      ;; is not in west.yml at all.
                      io.github.kotoba-lang/amu
                      {:local/root "../amu"}
                      io.github.kotoba-lang/kotoba-core-contracts
                      {:local/root "../kotoba-core-contracts"}
                      io.github.kotoba-lang/kotoba-lang
                      {:local/root "../kotoba-lang"}}
         ;; A sibling kotoba checkout may itself pin an unpublished
         ;; kotoba-lang commit.  extra-deps does not reliably win that
         ;; transitive coordinate; the workspace test profile must.
         :override-deps {io.github.kotoba-lang/kotoba-lang
                         {:local/root "../kotoba-lang"}
                         io.github.kotoba-lang/kotoba-core-contracts
                         {:local/root "../kotoba-core-contracts"}
                         io.github.kotoba-lang/kotoba-selfhost-contracts
                         {:local/root "../kotoba-selfhost-contracts"}
                         io.github.kotoba-lang/org-chainagnostic-cacao
                         {:local/root "../org-chainagnostic-cacao"}
                         io.github.kotoba-lang/datom
                         {:local/root "../datom"}
                         io.github.kotoba-lang/org-w3-did
                         {:local/root "../org-w3-did"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
       ;; T3 hosts — extra-deps, not core. Product name is kototama
       ;; (ADR-2608139980). Old GitHub names tender-* still redirect.
       :native-host
       {:extra-deps {io.github.kotoba-lang/kototama-native
                     {:git/url "https://github.com/kotoba-lang/kototama-native.git"
                      :git/sha "e52b41a68481033f40a511185e3347633612169a"}}}
       :component-host
       {:extra-deps {io.github.kotoba-lang/kototama-component
                     {:git/url "https://github.com/kotoba-lang/kototama-component.git"
                      :git/sha "d336ff74494c541566822f3a581956442b6c392f"}}}
       ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
       :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
